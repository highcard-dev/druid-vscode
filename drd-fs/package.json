{
  "name": "drd-fs",
  "displayName": "Druid Filesystem",
  "publisher": "druid",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:memfs"
  ],
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.setEntrypoint",
        "title": "Set Entrypoint"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.setEntrypoint",
          "when": "editorLangId == javascript"
        }
      ],
      "explorer/context": [
        {
          "command": "extension.setEntrypoint",
          "group": "1_modification@1"
        }
      ]
    },
    "configuration": {
      "title": "Druid Filesystem",
      "properties": {
        "druidfsprovider.apikey": {
          "type": "string",
          "default": "",
          "description": "API Key for Druid Filesystem"
        }
      }
    }
  },
  "scripts": {
    "check:lint": "eslint src --max-warnings=0",
    "check:type": "tsc",
    "package-web": "node -r esbuild-register scripts/bundle.ts",
    "compile-web": "node -r esbuild-register scripts/bundle.ts",
    "watch-web": "node -r esbuild-register scripts/bundle.ts --watch",
    "vscode:prepublish": "yarn run package-web",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "esbuild": "^0.24.0",
    "esbuild-register": "^3.5.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "enabledApiProposals": [
    "fileSearchProvider",
    "textSearchProvider",
    "ipc"
  ]
}
